# For local development and testing. Copy to .env and keep it private:
#   cp .env.example .env && chmod 600 .env
# Only this file is read. Shell environment variables are ignored on purpose.
# On Railway this file is not used: set the same names in the service's Variables.
# Put comments on their own line: "KEY=   # comment" would become part of the value.

# --- Telegram ---

# Bot token from @BotFather (/newbot). Keep it secret.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (ask @userinfobot). Business connections of any other account are ignored.
OWNER_ID=

# Which chats the assistant handles is chosen in Telegram: Settings → Telegram Business → Chatbots.

# false = preview mode: drafted replies are only printed in the log and saved to data/previews.jsonl.
# true  = replies are really sent from your account. Turn on only after you trust the previews.
AUTO_SEND=false

# --- Claude Code CLI (your Claude subscription, never an API key) ---

# Run `claude setup-token` on a computer with a browser (the token is valid for 1 year) and paste it
# here on ONE line, with an editor (not `echo`). It starts with sk-ant-oat. On Railway the same token
# goes into the CLAUDE_CODE_OAUTH_TOKEN variable. It is given only to the `claude` process.
# Treat it like a password. Empty = the `claude` login on this machine (local testing only).
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty = `claude` from PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Empty = the CLI's default model. Examples: sonnet, opus, claude-haiku-4-5 (faster, cheaper on limits).
CLAUDE_MODEL=

# How hard Claude thinks: low | medium | high | xhigh | max
CLAUDE_EFFORT=low

# Give up on one reply after this many seconds (minimum 1).
CLAUDE_TIMEOUT_SECONDS=120

# When the subscription limit is hit and the CLI doesn't say when it resets, stay quiet this many minutes.
LIMIT_COOLDOWN_MINUTES=30

# --- Behaviour ---

# After you write in a chat yourself, the assistant stays quiet in that chat for this many minutes.
OWNER_TAKEOVER_MINUTES=15

# Messages remembered per business connection and chat.
HISTORY_LIMIT=30
